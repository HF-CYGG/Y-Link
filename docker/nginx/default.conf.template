#
# 文件说明：前端分体部署容器的模板化 Nginx 配置。
# 实现逻辑：
# 1. 与固定版 `default.conf` 保持同样的静态托管与 API 代理行为；
# 2. 通过 upstream `server ... resolve` 在运行期解析后端域名，编排刚启动时后端未就绪也不会阻断 Nginx 启动；
#    不再使用“变量 + URI”的 proxy_pass：带变量时 Nginx 会用 URI 整体替换请求路径（例如 /api/orders?page=2 被转成 /api/），
#    改为具名 upstream 后按 location 前缀正常替换并保留查询参数，同时可用 keepalive 复用到后端的连接。
# 3. 供官方前端镜像在运行阶段由 `/etc/nginx/templates` 自动渲染。
#
map $status $ylink_log_abnormal {
    ~^[23] 0;
    default 1;
}

map "$request_method $request_uri" $ylink_log_important {
    default 0;
    ~^(POST|PUT|PATCH|DELETE)\s+/api/ 1;
    ~^GET\s+/(?!api/|assets/|uploads/|health(?:\?|$))(?:$|[^.?]*(?:\?.*)?$) 1;
}

map "$request_uri:$status:$time_iso8601" $ylink_log_health_sample {
    default 0;
    ~^/health(?:\?.*)?:200:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-5]0:[0-1][0-4] 1;
}

map "$ylink_log_abnormal$ylink_log_important$ylink_log_health_sample" $ylink_access_log_enabled {
    "000" 0;
    default 1;
}

map $request_uri $ylink_attack_class {
    default normal;
    ~^/wp-admin/ wp_probe;
    ~^/wp-includes/ wp_probe;
    ~^/xmlrpc\.php(?:\?|$) wp_probe;
    ~*^/phpmyadmin(?:/|\?|$) admin_probe;
    ~^/admin(?:/|\?|$) admin_probe;
    ~^/cgi-bin/ cgi_probe;
    ~^/nacos/ nacos_probe;
    ~^/theme/ theme_probe;
    ~^/user/umi\.min\.js(?:\?|$) umi_probe;
    ~^/\.env(?:[._~-][^/?]*)?(?:\?|$) secret_probe;
    ~^/(?:api|app|src|config|backend|frontend|server|web|public|private|var)/\.env(?:[._~-][^/?]*)?(?:\?|$) secret_probe;
    ~^/\.envrc(?:\?|$) secret_probe;
    ~^/\.flaskenv(?:\?|$) secret_probe;
    ~^/(?:config|secrets|credentials)\.json(?:\?|$) secret_probe;
    ~^/aws-config\.js(?:\?|$) secret_probe;
    ~^/(?:serviceAccountKey|service-account|firebase-service-account|google-service-account)\.json(?:\?|$) secret_probe;
    ~^/docker-compose(?:\.[^/?]+)?\.ya?ml(?:\?|$) secret_probe;
    ~^/\.git/HEAD(?:\?|$) git_probe;
    ~^/(?:.*/)?(?:webuploader|ueditor)(?:/|\?|$) editor_probe;
    ~^/api/v1/guest/comm/config(?:\?|$) external_api_probe;
    ~^/v[0-9]+/(?:models|logging)(?:/|\?|$) external_api_probe;
    ~^/robots\.txt(?:\?|$) crawler_probe;
}

# 匿名商城目录是分体/MySQL 部署下的主要公开读热点。短 TTL 微缓存把同一时刻的并发
# 浏览请求合并为一次后端回源；结算仍由后端事务读取生产库并重新校验库存。
limit_req_zone $binary_remote_addr zone=ylink_auth_login:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=ylink_auth_captcha:10m rate=30r/m;
# 敏感匿名入口（注册、发码、找回校验与重置）每 IP 限流；登录第二步（两步验证）与登录共用登录区。
limit_req_zone $binary_remote_addr zone=ylink_auth_sensitive:10m rate=30r/m;
# /api/ 通用每 IP 限流：拦截单一来源的高频洪水；校园 NAT 等大量用户共用出口 IP 时按需调大 rate 与 burst。
limit_req_zone $binary_remote_addr zone=ylink_api_general:20m rate=50r/s;
# 每 IP 同时处理中的请求上限（空闲长连接不计入）。
limit_conn_zone $binary_remote_addr zone=ylink_conn_per_ip:10m;

proxy_cache_path /var/cache/nginx/ylink-public levels=1:2 keys_zone=ylink_public_catalog:16m max_size=128m inactive=30m use_temp_path=off;
# 商品图（含 .thumb.webp 缩略图）文件名为 UUID、内容不可变，边缘缓存后不再每次回源 Node 读盘。
proxy_cache_path /var/cache/nginx/ylink-images levels=1:2 keys_zone=ylink_product_images:8m max_size=512m inactive=7d use_temp_path=off;

# 后端 upstream：zone + resolve 让 Docker 内置 DNS 在运行期解析 backend，keepalive 复用到 Node 的长连接，
# 避免每个代理请求都新建 TCP 连接。所有 location 都必须配合 proxy_http_version 1.1 与清空 Connection 头。
upstream ylink_backend {
    zone ylink_backend 64k;
    resolver 127.0.0.11 valid=30s ipv6=off;
    server backend:3001 resolve;
    keepalive 32;
    keepalive_timeout 50s;
}

log_format ylink_combined '$remote_addr - $remote_user [$time_local] "$request" '
                          '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                          'proxy="$realip_remote_addr" xff="$http_x_forwarded_for" real="$http_x_real_ip" '
                          'attack="$ylink_attack_class"';

include /etc/nginx/ylink/edge-protocol.conf;

server {
    listen 80;
    server_name _;

    include /etc/nginx/ylink/trusted-realip.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    access_log /dev/stdout ylink_combined if=$ylink_access_log_enabled;

    # 边缘限流与请求体上限：超限统一 429、请求体超限 413，均返回 JSON，前端按普通业务错误提示。
    # 默认请求体上限 1m；认证入口收紧到 64k，上传与导入入口在各自 location 放宽到 11m（比后端文件上限多留 multipart 边界与字段头的余量）。
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn ylink_conn_per_ip 256;
    client_max_body_size 1m;
    error_page 429 = @ylink_too_many_requests;
    error_page 413 = @ylink_payload_too_large;

    # 文本类前端静态资源开启 gzip，降低首屏与切页二次加载体积。
    gzip on;
    # 构建期已为文本资源生成 .gz（见 vite.config.ts 预压缩插件），存在时直接发送，免去每次请求实时压缩。
    gzip_static on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        text/javascript
        application/xml
        application/xml+rss
        image/svg+xml
        image/x-icon
        application/manifest+json
        font/ttf
        font/otf;

    # 前端静态托管层统一补基础安全头，避免浏览器做内容嗅探或被外部页面嵌入。
    include /etc/nginx/ylink/page-security-headers.conf;

    # 托管前端静态资源目录。
    root /usr/share/nginx/html;
    index index.html;

    # public/ 下未带哈希的站点图标不能按 immutable 缓存一年，否则更换图标后已访问过的用户长期看不到新图标；
    # 该正则必须位于下方通用静态资源正则之前（正则 location 按出现顺序匹配）。
    location ~ ^/(?:favicon\.ico|y-link-icon\.png|apple-touch-icon\.png|icons\.svg)$ {
        try_files $uri =404;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }

    # Vite 构建出的 hash 资源可长期缓存，减少重复下载。
    location ~* \.(?:css|js|mjs|json|map|svg|ico|png|jpe?g|webp|gif|woff2?|ttf|otf|eot)$ {
        try_files $uri =404;
        expires 365d;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # 入口 HTML 需要及时拿到最新版本，避免用户长期缓存旧入口引用已失效的 hash 资源。
    location = /index.html {
        try_files /index.html =404;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # 救援页是独立 Vite 入口，不能落入普通 SPA 路由或其缓存策略。
    location = /database-rescue {
        try_files /rescue.html =404;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /rescue.html {
        try_files /rescue.html =404;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /xmlrpc.php { return 404; }
    location = /.env { return 404; }
    location = /config.json { return 404; }
    location = /aws-config.js { return 404; }
    location = /secrets.json { return 404; }
    location = /credentials.json { return 404; }
    location = /serviceAccountKey.json { return 404; }
    location = /service-account.json { return 404; }
    location = /firebase-service-account.json { return 404; }
    location = /google-service-account.json { return 404; }
    location = /api/v1/guest/comm/config { return 404; }
    location = /user/umi.min.js { return 404; }
    location = /uploads/ { return 404; }
    location = /.envrc { return 404; }
    location = /.flaskenv { return 404; }
    location = /.git/HEAD { return 404; }

    location ^~ /wp-admin/ { return 404; }
    location ^~ /wp-includes/ { return 404; }
    location ^~ /phpmyadmin/ { return 404; }
    location ^~ /api/.env { return 404; }
    location ^~ /cgi-bin/ { return 404; }
    location ^~ /nacos/ { return 404; }
    location ^~ /theme/ { return 404; }

    location ~ ^/\.env(?:[._~-][^/]*)?$ { return 404; }
    location ~ ^/(?:app|src|config|backend|frontend|server|web|public|private|var)/\.env(?:[._~-][^/]*)?$ { return 404; }
    location ~ ^/docker-compose(?:\.[^/]+)?\.ya?ml$ { return 404; }
    location ~ ^/(?:.*/)?(?:webuploader|ueditor)(?:/|$) { return 404; }
    location ~ ^/v[0-9]+/(?:models|logging)(?:/|$) { return 404; }
    location ~* ^/phpmyadmin(?:/|$) { return 404; }

    # Vue Router history 模式回退：
    # - 优先返回真实静态文件；
    # - 其余路径统一回落到 index.html 交给前端路由处理。
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/ylink/page-security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /api/auth/login {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-auth/login {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/captcha {
        limit_req zone=ylink_auth_captcha burst=8 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-auth/captcha {
        limit_req zone=ylink_auth_captcha burst=8 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/login/mfa {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/login/mfa/webauthn/options {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/login/mfa/webauthn/verify {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/webauthn/login/options {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/auth/webauthn/login/verify {
        limit_req zone=ylink_auth_login burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }
    location = /api/client-auth/register {
        limit_req zone=ylink_auth_sensitive burst=10 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-auth/verification-code/send {
        limit_req zone=ylink_auth_sensitive burst=10 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-auth/forgot-password/verify {
        limit_req zone=ylink_auth_sensitive burst=10 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-auth/forgot-password/reset {
        limit_req zone=ylink_auth_sensitive burst=10 nodelay;
        client_max_body_size 64k;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    # 这两个路由当前均为完全匿名且不按 Cookie 个性化的公开数据。
    # 若后续引入用户专属价格或可见范围，必须先移除共享缓存或把身份维度纳入 cache key。
    location = /api/o2o/mall/products {
        limit_req zone=ylink_api_general burst=500 nodelay;
        proxy_pass http://ylink_backend/api/o2o/mall/products;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
        proxy_cache ylink_public_catalog;
        proxy_cache_key "$scheme$request_method$host$uri$is_args$args";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 5s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=2, stale-while-revalidate=30" always;
        add_header X-YLink-Cache $upstream_cache_status always;
    }

    location = /api/o2o/mall/storefront {
        limit_req zone=ylink_api_general burst=500 nodelay;
        proxy_pass http://ylink_backend/api/o2o/mall/storefront;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
        proxy_cache ylink_public_catalog;
        proxy_cache_key "$scheme$request_method$host$uri$is_args$args";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 30s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=15, stale-while-revalidate=60" always;
        add_header X-YLink-Cache $upstream_cache_status always;
    }

    # API 反向代理：
    # - 默认走同编排服务名 backend:3001；
    # - 使用变量+resolver 做延迟解析，避免容器启动阶段因 DNS 瞬态失败直接退出。
    location @ylink_too_many_requests {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "5" always;
        return 429 '{"code":429,"message":"请求过于频繁，请稍后再试","data":{"reason":"EDGE_RATE_LIMITED"}}';
    }

    location @ylink_payload_too_large {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 413 '{"code":413,"message":"请求内容过大，请压缩或拆分后重试","data":{"reason":"EDGE_PAYLOAD_TOO_LARGE"}}';
    }

    # 上传与导入入口：请求体上限放宽到 11m。后端 multer / JSON 上限为商品图 10MB、名录导入 8MB、商品导入 5MB，
    # 而 Nginx 限制的是整个 multipart 请求体（含边界与字段头），必须略高于文件上限，否则合法的 10MB 图片会在到达后端前被 413。
    location = /api/upload {
        limit_req zone=ylink_api_general burst=500 nodelay;
        client_max_body_size 11m;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /api/client-feedback/attachments {
        limit_req zone=ylink_api_general burst=500 nodelay;
        client_max_body_size 11m;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location ^~ /api/products/import {
        limit_req zone=ylink_api_general burst=500 nodelay;
        client_max_body_size 11m;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location ^~ /api/system-configs/client-staff-directory/import {
        limit_req zone=ylink_api_general burst=500 nodelay;
        client_max_body_size 11m;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    location ^~ /api/ {
        limit_req zone=ylink_api_general burst=500 nodelay;
        proxy_pass http://ylink_backend/api/;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    # 商品图片等上传静态资源实际落在后端容器磁盘，
    # 这里显式代理给后端，避免前端容器误把 `/uploads/*` 当成自身静态文件处理。
    # 上传图片与 /api/ 共用每 IP 通用限流，防止单一来源刷图片拖垮 Node 静态读盘。
    location ^~ /uploads/ {
        limit_req zone=ylink_api_general burst=500 nodelay;
        proxy_pass http://ylink_backend/uploads/;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
    }

    # 商品图（含缩略图）为 UUID 文件名且内容不可变：边缘缓存 7 天，命中后不再回源 Node；
    # 私有反馈附件仍走上方 /uploads/ 由后端鉴权与 404 兜底，绝不进入这个缓存。
    location ^~ /uploads/products/ {
        limit_req zone=ylink_api_general burst=500 nodelay;
        proxy_pass http://ylink_backend;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        proxy_set_header Connection "";
        proxy_cache ylink_product_images;
        proxy_cache_key "$scheme$request_method$host$uri";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 10s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        add_header X-YLink-Cache $upstream_cache_status always;
    }

    # 健康检查也转发到后端，便于容器联调时直接探活。
    location = /health {
        proxy_pass http://ylink_backend/health;
        proxy_http_version 1.1;
        include /etc/nginx/ylink/proxy-security-headers.conf;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $ylink_forwarded_proto;
        add_header Cache-Control "no-store" always;
    }
}
