# 模块说明：前后端合并部署 (Onebox) Docker 构建文件
# 文件职责：定义在一个容器内同时打包运行 Node 后端与 Nginx 前端的构建过程
# 维护说明：若后端或前端构建依赖环境发生改变（如 Node 版本升级），需同步修改此处

# ------------------------------
# 文件说明：Y-Link 单镜像 onebox 构建文件。
# 实现逻辑：
# 1. 先分别复制根目录与 backend 的 `.npmrc`，让前后端构建都走官方 npm 源；
# 2. 再分别构建前端静态资源与后端 TypeScript 产物；
# 3. 最后把前端、后端、Nginx 与入口脚本组装进同一运行镜像；
# 4. 容器启动后由 `entrypoint.sh` 同时拉起 Node 后端与 Nginx 反向代理。
# ------------------------------
# Onebox 默认依赖 sqlite3，Node 主版本必须与其 N-API 发行产物联合验收。
# 固定到 Node 22 最新安全补丁版本；Node 发布新安全版本后 `npm run verify:security-updates` 会报红，需同步升级全部 Node 版本固定点。
ARG Y_LINK_NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.5-bookworm-slim

FROM --platform=$BUILDPLATFORM ${Y_LINK_NODE_IMAGE} AS frontend-build
WORKDIR /app
COPY package*.json ./
COPY .npmrc ./
# 根 lockfile 同时服务 Web、Mobile 与共享包；Onebox 前端阶段只安装 Web 依赖。
RUN npm ci --workspaces=false
COPY index.html ./
COPY rescue.html ./
COPY public ./public
COPY scripts ./scripts
COPY src ./src
COPY packages/shared-types ./packages/shared-types
COPY packages/validation ./packages/validation
COPY tsconfig.json ./
COPY tsconfig.app.json ./
COPY tsconfig.node.json ./
COPY vite.config.ts ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
RUN npm run build

# ------------------------------
# 后端构建阶段：编译服务端 TypeScript 代码。
# ------------------------------
# 后端编译同样固定在 $BUILDPLATFORM 上执行：tsc 是纯 JavaScript，产物与目标架构无关。
# `--ignore-scripts` 跳过 sqlite3 / sharp 的原生编译，本阶段只需要它们的类型定义；
# 真正与架构绑定的原生产物由下方 backend-prod-deps 阶段在目标平台安装。
FROM --platform=$BUILDPLATFORM ${Y_LINK_NODE_IMAGE} AS backend-build
WORKDIR /backend
COPY backend/package*.json ./
COPY backend/.npmrc ./.npmrc
RUN npm ci --ignore-scripts
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

# ------------------------------
# 后端运行时依赖阶段：仅保留生产依赖，减小最终镜像体积。
# ------------------------------
FROM ${Y_LINK_NODE_IMAGE} AS backend-prod-deps
WORKDIR /backend
# 官方 Node 镜像已内置 /usr/local/include/node；显式复用本地头文件，
# 避免 sqlite3 回退 node-gyp 时还需外网下载与运行时完全匹配的 Node headers。
ENV npm_config_nodedir=/usr/local
# sqlite3 在新 Node ABI 尚无预编译包时会自动回退 node-gyp；构建工具只存在于该中间层，
# 最终运行镜像不会携带编译器。缺失这些工具会让 optional sqlite3 被 npm 静默跳过，
# 直到 Onebox 启动时才报 DriverPackageNotInstalled。
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY backend/package*.json ./
COPY backend/.npmrc ./.npmrc
RUN npm ci --omit=dev \
  && node -e "require('sqlite3')"

# ------------------------------
# onebox 运行阶段：在同一容器中组合 Node 后端与 Nginx。
# ------------------------------
FROM ${Y_LINK_NODE_IMAGE} AS runtime

ARG Y_LINK_NGINX_VERSION=1.30.6-1~bookworm
# 独立 signed-by 仅信任核验过指纹的 nginx.org 签名公钥；不扩大系统全局信任。
RUN set -eu; \
  apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl gnupg ca-certificates tzdata \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in amd64|arm64) ;; *) exit 1 ;; esac \
  && export GNUPGHOME="$(mktemp -d)" \
  && curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 https://nginx.org/keys/nginx_signing.key -o /tmp/nginx-signing.key \
  && gpg --batch --import /tmp/nginx-signing.key \
  && nginx_key_fingerprints='573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62 8540A6F18833A80E9C1653A42FD21310B49F6B46 9E9BE90EACBCDE69FE9B204CBCDCD8A38D88A2B3' \
  && for fingerprint in $nginx_key_fingerprints; do \
       gpg --batch --with-colons --fingerprint "$fingerprint" | grep -qx "fpr:::::::::$fingerprint:" || exit 1; \
       printf 'Verified nginx signing fingerprint: %s\n' "$fingerprint"; \
     done \
  && gpg --batch --export $nginx_key_fingerprints > /usr/share/keyrings/nginx-archive-keyring.gpg \
  && chmod 0644 /usr/share/keyrings/nginx-archive-keyring.gpg \
  && printf 'deb [arch=%s signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian bookworm nginx\n' "$arch" > /etc/apt/sources.list.d/nginx.list \
  && apt-get update \
  && gpgv --status-fd 1 --keyring /usr/share/keyrings/nginx-archive-keyring.gpg /var/lib/apt/lists/nginx.org_packages_debian_dists_bookworm_InRelease \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "nginx=${Y_LINK_NGINX_VERSION}" \
  && mkdir -p /var/cache/nginx/ylink-public /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp /var/cache/nginx/scgi_temp \
  && chown -R www-data:www-data /var/cache/nginx/ylink-public \
  && chown -R www-data:www-data /var/cache/nginx/*_temp \
  && rm -f /etc/nginx/sites-enabled/default \
  && rm -f /etc/nginx/conf.d/default.conf \
  && rm -rf "$GNUPGHOME" /tmp/nginx-signing.key /var/lib/apt/lists/*

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=frontend-build /app/dist /usr/share/nginx/html
COPY docker/nginx/onebox-nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/onebox.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/page-security-headers.conf /etc/nginx/ylink/page-security-headers.conf
COPY docker/nginx/proxy-security-headers.conf /etc/nginx/ylink/proxy-security-headers.conf
COPY docker/nginx/configure-proxy-boundary.sh /usr/local/bin/ylink-proxy-boundary

COPY --from=backend-build /backend/dist /app/backend/dist
COPY --from=backend-prod-deps /backend/node_modules /app/backend/node_modules
COPY backend/package.json /app/backend/package.json
# 启动期 MySQL 自动迁移与订单编号领养按 dist 相对路径读取 backend/sql，缺失会阻断开启 DB_AUTO_MIGRATE 的启动。
COPY backend/sql /app/backend/sql

COPY docker/onebox/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "require('node:http').get('http://127.0.0.1/health', (res) => process.exit(res.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
