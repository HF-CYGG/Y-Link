# syntax=docker/dockerfile:1

# ------------------------------
# 文件说明：Y-Link 后端 MySQL-only 生产镜像构建文件。
# 实现逻辑：
# - 保留 sharp 等运行必需的可选平台包，再显式移除 sqlite3，避免 MySQL 生产镜像携带 sqlite3/node-gyp/tar 审计链；
# - 仅适用于 DB_TYPE=mysql 的公网或正式部署；
# - 如需 SQLite 一体化部署，继续使用 backend/Dockerfile。
# ------------------------------
ARG Y_LINK_NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim

FROM ${Y_LINK_NODE_IMAGE} AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY sql ./sql
RUN npm run build \
  && npm prune --omit=dev \
  && npm uninstall sqlite3

FROM ${Y_LINK_NODE_IMAGE} AS runtime

WORKDIR /app

# libuv 线程池默认 4 线程，由 scrypt、sharp、数据库驱动与文件读写共用；登录洪水时业务查询会被饿死，扩到 8。
ENV NODE_ENV=production \
  PORT=3001 \
  DB_TYPE=mysql \
  DB_SYNC=false \
  TZ=Asia/Shanghai \
  UV_THREADPOOL_SIZE=8

# 预建 /app/data：挂载命名卷时 Docker 会沿用镜像目录的属主，node 用户才能写入维护状态与数据加密密钥文件。
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /app/data /app/uploads \
  && chown -R node:node /app

COPY --from=build --chown=node:node /app/package*.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/sql ./sql

USER node

EXPOSE 3001

CMD ["npm", "run", "start"]
