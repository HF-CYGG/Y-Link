Description: Node内嵌旧zlib的85091借用期窄适配候选
Origin: https://github.com/madler/zlib/commit/df84af25dc1942490e1d1c899a07619152a46148
Comment: 保留旧gz_write的零返回、预先位置计数、输出缓冲/CRC/deflate状态，不引入again或部分返回语义；未构建或运行触发器。

diff --git a/deps/zlib/gzwrite.c b/deps/zlib/gzwrite.c
--- a/deps/zlib/gzwrite.c
+++ b/deps/zlib/gzwrite.c
@@ -223,8 +223,12 @@
                 n = (unsigned)len;
             state->strm.avail_in = n;
             state->x.pos += n;
-            if (gz_comp(state, Z_NO_FLUSH) == -1)
+            if (gz_comp(state, Z_NO_FLUSH) == -1) {
+                /* 失败后结束调用方输入借用，保留旧返回值和位置计数。 */
+                state->strm.avail_in = 0;
+                state->strm.next_in = state->in;
                 return 0;
+            }
             len -= n;
         } while (len);
     }
