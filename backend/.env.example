# 模块说明：后端环境变量模板（通用）
# 文件职责：提供后端服务在本地/服务器运行时的环境变量默认示例
# 维护说明：新增后端必需环境变量时，需同步更新此模板并保持注释说明一致

NODE_ENV=development
PORT=3001
APP_PROFILE=default
TZ=Asia/Shanghai

# 可选：显式指定额外 env 文件。
# - 留空：仅按 `.env` / `.env.<APP_PROFILE>` 规则加载
# - 填写：最终再加载该文件，可覆盖前面的配置
ENV_FILE=

# 数据库模式：
# - sqlite：默认一体化部署，自动创建本地 SQLite 文件
# - mysql：连接外置 MySQL 服务
DB_TYPE=sqlite

# SQLite 一体化模式配置
# - default profile 默认写入 ./data/y-link.sqlite
# - 非 default profile 且未显式设置时，默认写入 ./data/local-dev/y-link.<profile>.sqlite
SQLITE_DB_PATH=./data/y-link.sqlite

# MySQL 分体化模式配置（当 DB_TYPE=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=y_link

# MySQL 生产连接池与慢查询基线（仅 DB_TYPE=mysql 时生效）
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100

# 两种数据库共用的慢查询记录阈值；日志只记录脱敏 SQL 形状，不记录参数
DB_MAX_QUERY_MS=200
# MySQL 传输加密：disabled（默认）/ required（加密不校验证书，仅过渡）/ verify-full（校验证书链与主机名，外置或云数据库推荐）。
# verify-full 可用 DB_SSL_CA 指定容器内可读的 CA 证书文件路径（PEM），未指定则使用 Node 内置根证书。
DB_SSL_MODE=disabled
DB_SSL_CA=

# SQLite Onebox 性能与耐久性配置（仅 DB_TYPE=sqlite 时生效）
# FULL 为默认耐久档；NORMAL 仅适合明确接受断电时最近提交可能丢失的场景
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
SQLITE_JOURNAL_SIZE_LIMIT_BYTES=67108864
SQLITE_WRITE_QUEUE_MAX_PENDING=256
SQLITE_WRITE_QUEUE_TIMEOUT_MS=5000

# 数据库并发验收专用 MySQL 临时库连接（执行 `npm run verify:db:concurrency` 时生效）
# - 脚本会固定创建并使用临时库 `y_link_verify_db_concurrency`
# - 默认会优先尝试自动拉起 Docker MySQL 临时环境；如需关闭可设置 `VERIFY_DB_CONCURRENCY_AUTO_PREPARE=off`
# - 若关闭自动准备且仍留空，则会回退复用上面的 DB_HOST / DB_PORT / DB_USER / DB_PASSWORD
# - 脚本不会复用 DB_NAME 指向的业务库
VERIFY_DB_CONCURRENCY_AUTO_PREPARE=
VERIFY_DB_CONCURRENCY_MYSQL_HOST=
VERIFY_DB_CONCURRENCY_MYSQL_PORT=
VERIFY_DB_CONCURRENCY_MYSQL_USER=
VERIFY_DB_CONCURRENCY_MYSQL_PASSWORD=

# 数据库并发验收专用 Docker MySQL 临时环境配置（当自动准备开启时生效）
# - 仅用于 `npm run verify:db:concurrency` 的临时受控环境，不影响业务运行库
# - 如本地 3406 端口冲突，可改为其它未占用端口
VERIFY_DB_CONCURRENCY_DOCKER_HOST=127.0.0.1
VERIFY_DB_CONCURRENCY_DOCKER_PORT=3406
VERIFY_DB_CONCURRENCY_DOCKER_ROOT_PASSWORD=
VERIFY_DB_CONCURRENCY_DOCKER_IMAGE=mysql:8.4
VERIFY_DB_CONCURRENCY_DOCKER_PROJECT=y-link-verify-db-concurrency
VERIFY_DB_CONCURRENCY_DOCKER_STARTUP_TIMEOUT_MS=90000

# 是否启用 TypeORM synchronize：
# - 留空时：SQLite 首次启动自动建表，MySQL 默认关闭
# - true：每次启动同步实体结构（仅建议本地开发使用）
# - false：完全关闭自动同步
DB_SYNC=

# 是否在启动阶段自动执行 backend/sql/ 下已核实幂等的增量迁移脚本（仅 DB_TYPE=mysql 时生效）：
# - 留空/false：不自动执行，缺表时启动会直接失败并提示需要手动执行的脚本
# - true：自动执行白名单内的迁移脚本（当前为 033、037、038、039）
# 注意：仍需运维自行执行 backend/sql/ 下未进入自动执行白名单的历史脚本，详见该目录内文件头说明
DB_AUTO_MIGRATE=

# 登录态有效时长（小时）
AUTH_TOKEN_TTL_HOURS=168

# 管理端会话空闲超时（分钟）：标签页可见时每分钟心跳续期，隐藏或关闭超过该时长后需重新登录；0 表示关闭
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=720

# Native Mobile 独立 Bearer 会话（只配置时效与安全阈值，不包含任何密钥）
MOBILE_ACCESS_TTL_MINUTES=15
MOBILE_REFRESH_TTL_DAYS=30
MOBILE_SESSION_ABSOLUTE_TTL_DAYS=90
MOBILE_REFRESH_GRACE_SECONDS=60
MOBILE_MAX_ACTIVE_SESSIONS=10
MOBILE_REFRESH_ROTATION_RATE_LIMIT=10
MOBILE_REFRESH_ROTATION_RATE_WINDOW_SECONDS=60

# 首次启动默认管理员初始化账号
INIT_ADMIN_USERNAME=admin
# 安全要求：必须显式填写私有强密码，禁止继续使用历史默认口令
INIT_ADMIN_PASSWORD=请替换为你自己的私有强密码
INIT_ADMIN_DISPLAY_NAME=系统管理员

# 验证码平台外部请求超时（毫秒）
VERIFICATION_CODE_REQUEST_TIMEOUT_MS=8000

# 阿里云 PNVS 服务端动态短信验证码：仅在后台将短信 providerType 切为 aliyun_dypns 后使用。
# 必须从私有密钥管理系统注入，禁止提交真实 AccessKey 或 HMAC 密钥。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 用于 HMAC 关联手机号与受理记录；生产环境至少 32 个随机字节。
VERIFICATION_TICKET_HMAC_SECRET=
# 是否启动固定 MNS 队列回执 Worker；启用时缺少阿里云凭证会明确阻断启动。
ALIYUN_DYPNS_MNS_ENABLED=false

# 教师 8 位邀请码 HMAC 密钥：生产环境至少 32 个随机字节，不得提交真实值。
INVITE_CODE_PEPPER=

# JSON 全量导入导出（含全部客户个人信息与密码哈希）默认关闭；仅在迁移或运维窗口临时设为 true，用完立即关闭。
# 开启后导出/导入仍须提交本人当前密码复核，导入另需永久删除口令。
Y_LINK_JSON_DATA_TRANSFER_ENABLED=false

# 敏感配置落库加密主密钥（可选）：默认自动生成在数据目录 secrets/data-encryption.key，单实例无需配置。
# 仅多个后端实例共用一个 MySQL 时，才需要在每个实例注入同一个 32 字节密钥（base64 或 64 位十六进制），不得提交真实值。
# Y_LINK_DATA_ENCRYPTION_KEY=

# 全局撞库态势：同一端 5 分钟内全站登录失败达到阈值后，该端所有登录强制图形验证码，持续 HOLD 分钟。
# 默认值适合单实例；登录量很大的部署可适当调高阈值，留空即用默认。
# YLINK_ADMIN_GLOBAL_FAILURE_THRESHOLD=30
# YLINK_CLIENT_GLOBAL_FAILURE_THRESHOLD=150
# YLINK_GLOBAL_CAPTCHA_HOLD_MINUTES=15
