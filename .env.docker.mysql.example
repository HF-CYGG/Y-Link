# 模块说明：Docker 外置 MySQL 部署环境变量配置
# 文件职责：提供云端 Docker 结合外置 MySQL 的部署环境变量参考模板
# 维护说明：当系统新增必须的部署环境变量时，需同步更新此模板文件

#
# 文件说明：Docker + 外置 MySQL 部署的环境变量模板。
# 实现逻辑（全新空库首次部署）：
# 1. 复制为 `.env.docker.mysql` 后填写真实的 MySQL 连接参数，并建好空数据库；
# 2. 先把下面的 `DB_SYNC` 设为 `true`，用 `compose.mysql.yml` 启动一次后端，
#    由 TypeORM 按实体结构完成首次建表（日志出现 action=synchronized reason=forced_by_db_sync 即完成）；
# 3. 建表完成后把 `DB_SYNC` 改回 `false` 并重启，避免后续每次启动都同步实体结构；
# 4. 之后每次启动都会自检一组关键表是否存在，缺表会直接拒绝启动并给出具体修复指引。
#
# 注意：请勿按编号顺序执行 `backend/sql/` 下的脚本来初始化全新库。
# 那些脚本虽已全部改造为幂等写法、可安全单独重放，但整个目录是按时间累积的增量记录，
# 从未作为完整基线在真实 MySQL 8 空库上端到端验证过（脚本间顺序依赖与数据回填假设均未校验）。
# 该目录仅用于给已有库补齐特定的增量变更（例如 033 补 auth_risk_state 表）。
#

# 宿主机端口映射
FRONTEND_PORT=8080
BACKEND_PORT=3001
TZ=Asia/Shanghai

# 外置 MySQL 连接信息
# - 如果 MySQL 部署在宿主机本机，可优先尝试 host.docker.internal
# - 如果是局域网或云数据库，请替换为真实可达地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=ylink
DB_PASSWORD=
DB_NAME=y_link

# MySQL 连接池、排队保护与慢查询阈值：适用于单个后端实例。
# 多副本部署时，所有实例的 DB_POOL_SIZE 总和必须小于 MySQL max_connections，并预留运维连接。
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100
# 超过此耗时（毫秒）的查询记录脱敏 SQL 形状，不记录参数值。
DB_MAX_QUERY_MS=200

# 是否允许 TypeORM 按实体结构自动同步表结构：
# - 全新空库首次部署：先设为 true 启动一次完成建表，成功后改回 false 并重启（见文件头步骤）
# - 日常运行：保持 false，避免每次启动都同步实体结构
DB_SYNC=false

# 是否在启动阶段自动执行 backend/sql/ 下已核实幂等的增量迁移脚本：
# - false/留空：推荐，缺表时启动会直接失败并提示需要手动执行的具体脚本
# - true：自动执行白名单内的迁移脚本（当前仅 033_inventory_security_invariants.sql）
# 说明：该开关只用于给"已初始化过的存量库"补齐特定增量，不能用于初始化全新空库
DB_AUTO_MIGRATE=false

# 首次管理员初始化：
# - 必填：请在 1Panel / Docker 面板环境变量中手动填写私有强密码，不要提交真实密码。
# - 系统会拒绝历史弱口令 Admin@123456。
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_DISPLAY_NAME=系统管理员
INIT_ADMIN_PASSWORD=
# 可选但建议：永久删除订单/送货单时使用的二次门禁密码；不配置时永久删除接口会被拒绝。
PERMANENT_DELETE_PASSWORD=
# 教师邀请码 HMAC 密钥：至少 32 个随机字节；不配置时教师邀请码接口不可用。
INVITE_CODE_PEPPER=
