# 模块说明：Docker 外置 MySQL 部署环境变量配置
# 文件职责：提供云端 Docker 结合外置 MySQL 的部署环境变量参考模板
# 维护说明：当系统新增必须的部署环境变量时，需同步更新此模板文件

#
# 文件说明：Docker + 外置 MySQL 部署的环境变量模板。
# 实现逻辑：
# 1. 复制为 `.env.docker.mysql` 后填写真实的 MySQL 连接参数；
# 2. 全新空库首次启动时临时设置 `DB_SYNC=true` 让实体创建完整结构，成功后立即改回 `false` 并重启；
# 3. 存量库禁止用 `DB_SYNC=true` 代替升级，应在备份和预发演练后按版本顺序执行增量 SQL；
# 4. 最后配合 `compose.mysql.yml` 启动前后端应用容器。
#

# 宿主机端口映射
FRONTEND_PORT=8080
BACKEND_PORT=3001
TZ=Asia/Shanghai

# 外置 MySQL 连接信息
# - 如果 MySQL 部署在宿主机本机，可优先尝试 host.docker.internal
# - 如果是局域网或云数据库，请替换为真实可达地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=ylink
DB_PASSWORD=
DB_NAME=y_link

# MySQL 连接池、排队保护与慢查询阈值：适用于单个后端实例。
# 多副本部署时，所有实例的 DB_POOL_SIZE 总和必须小于 MySQL max_connections，并预留运维连接。
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100
# 超过此耗时（毫秒）的查询记录脱敏 SQL 形状，不记录参数值。
DB_MAX_QUERY_MS=200

# 是否允许 TypeORM 自动同步：
# - false：生产常态与存量库升级必须使用
# - true：只允许全新空库第一次创建实体结构，首启成功后必须立即改回 false 并重启
DB_SYNC=false

# 首次管理员初始化：
# - 必填：请在 1Panel / Docker 面板环境变量中手动填写私有强密码，不要提交真实密码。
# - 系统会拒绝历史弱口令 Admin@123456。
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_DISPLAY_NAME=系统管理员
INIT_ADMIN_PASSWORD=
# 可选但建议：永久删除订单/送货单时使用的二次门禁密码；不配置时永久删除接口会被拒绝。
PERMANENT_DELETE_PASSWORD=
# 教师邀请码 HMAC 密钥：至少 32 个随机字节；不配置时教师邀请码接口不可用。
INVITE_CODE_PEPPER=
