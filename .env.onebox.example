# Onebox 基础配置：复制为 .env 后再启动。
TZ=Asia/Shanghai
Y_LINK_PORT=8080
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_DISPLAY_NAME=系统管理员
INIT_ADMIN_PASSWORD=
PERMANENT_DELETE_PASSWORD=
# JSON 全量导入导出（含全部客户数据与密码哈希）默认关闭，仅迁移/运维窗口临时设为 true，用完改回 false。
Y_LINK_JSON_DATA_TRANSFER_ENABLED=false
# 验证码网关、飞书等密钥类配置落库加密：密钥首次启动自动生成在数据卷 /app/data/secrets/data-encryption.key，
# 无需在此配置，但备份或迁移数据卷时必须一并带上，否则需重新录入这些配置。
# 其余登录风控与过载削峰阈值说明见 backend/.env.example；自定义变量须先在 Compose 的 environment 中映射。
# 后端在容器内只监听回环地址，外部流量必须经过 Nginx。
INVITE_CODE_PEPPER=

# Onebox 内存设置。NODE_OPTIONS 已显式设置 --max-old-space-size 时优先使用它的值。
NODE_OPTIONS=
Y_LINK_NODE_MAX_OLD_SPACE_MB=256
MALLOC_ARENA_MAX=2
# 2 GiB 单机可按数据库模式调小线程池，SQLite 建议 6，MySQL 建议 4。
UV_THREADPOOL_SIZE=8
# 2 GiB 单机建议 2、2、1。留空使用后端内置并发阈值。
YLINK_PASSWORD_HASH_CONCURRENCY=
YLINK_CAPTCHA_RENDER_CONCURRENCY=
YLINK_PRODUCT_IMAGE_CONCURRENCY=
# 报表、审计、库存流水与商品导出共享当前进程的并发上限。
Y_LINK_MAX_CONCURRENT_EXPORTS=2

# 阿里云 PNVS 短信验证码。密钥只能从私有部署环境注入，禁止提交真实值。
VERIFICATION_CODE_REQUEST_TIMEOUT_MS=8000
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 用于 HMAC 关联手机号与受理记录；生产环境至少 32 个随机字节。
VERIFICATION_TICKET_HMAC_SECRET=
ALIYUN_DYPNS_MNS_ENABLED=false
# Onebox 具备退出码 75 重启恢复链路，默认允许自动迁移；不允许在线切库时可设为 false。
Y_LINK_AUTOMATIC_DB_MIGRATION_ENABLED=true

# SQLite Onebox 安全默认值通常无需修改。若 /health 显示写队列持续拥塞，应迁移 MySQL，
# 不要靠无限加大队列掩盖容量不足。
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000
# 2 GiB 单机可将 SQLite 页缓存调至 32768 KiB。
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_WRITE_QUEUE_MAX_PENDING=256
SQLITE_WRITE_QUEUE_TIMEOUT_MS=5000

# 迁移 MySQL 后由运行时覆盖使用；单个 Onebox 默认 20 条连接，2 GiB 单机建议调至 10。
# 外置 MySQL 可设 verify-full，迁移及运行均校验证书链和服务名。私有 CA 指向容器内可读的 PEM 文件。
DB_SSL_MODE=disabled
DB_SSL_CA=
# 切换到 MySQL 后，true 启用启动期白名单迁移。
DB_AUTO_MIGRATE=false
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100
# MySQL 会话锁等待上限（秒）：死锁或长事务持锁时等待方快速失败，由幂等事务重试或返回“数据库繁忙”（MySQL 默认 50 秒）。
DB_LOCK_WAIT_TIMEOUT_SECONDS=15
# MySQL 会话空闲上限（秒）：应用容器意外停止或网络中断时，残留的未提交事务在空闲超过该时间后被回滚并释放行锁；
# 实际生效值不小于 DB_IDLE_TIMEOUT_MS 换算秒数 + 60。
DB_SESSION_WAIT_TIMEOUT_SECONDS=600
DB_MAX_QUERY_MS=200

# ---------------------------------------------------------------------------
# 可选：独立部署的 Redis（Onebox 为单实例，通常无需启用；多实例 + 独立 MySQL 的高并发部署使用，要求 Redis >= 6.2，推荐 7.x）
# - REDIS_URL 留空 = 不启用，行为与未接入 Redis 时完全一致（单实例部署无需配置）；
# - 启用后承接安全票据、限流风控、SSE 跨实例广播、客服在线态、缓存失效广播与后台任务租约；
# - 连接信息只能通过环境变量注入，不会写入运行时覆盖文件；密码请放在 REDIS_PASSWORD，不要写进 URL。
# ---------------------------------------------------------------------------
# 形如 redis://host:6379/0 或 rediss://host:6380，必须以 redis:// 或 rediss:// 开头
REDIS_URL=
# 可选：Redis 6+ ACL 用户名
REDIS_USERNAME=
# 可选：Redis 密码（建议放在这里而不是 URL 中）
REDIS_PASSWORD=
# 可选：库编号，0-15
REDIS_DB=
# 跨网络连接时设为 true 开启 TLS（rediss:// 视同开启）；自签 CA 用 REDIS_TLS_CA 指定容器内可读的 PEM 文件路径
REDIS_TLS=false
REDIS_TLS_CA=
# 键名前缀：1-32 位字母、数字与 : _ . -；多套环境共用同一个 Redis 时用它隔离
REDIS_KEY_PREFIX=ylink:
# 连接超时（250-60000 毫秒）与单命令超时（50-10000 毫秒）；命令超时较短，使 Redis 抖动时快速失败并走降级
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=500
# 多实例模式：true 时启动期强制要求 DB_TYPE=mysql、已配置 REDIS_URL、
# 且所有实例通过 Y_LINK_DATA_ENCRYPTION_KEY 注入同一把数据加密密钥，缺一拒绝启动；Redis 首连失败也拒绝启动。
Y_LINK_MULTI_INSTANCE=false
# 多实例必填：所有实例必须一致的数据加密密钥，请从私有部署环境注入，禁止提交真实值。
Y_LINK_DATA_ENCRYPTION_KEY=

# 正式加载 compose.onebox.mysql.yml 前再填写；叠加文件会对两个密码 fail-fast。
# 管理端自动迁移目标填写：host=mysql、port=3306、database=y_link、user=ylink。
# 若 MySQL 安装在 Linux 宿主机，可填写 host=host.docker.internal；远程数据库填写容器可达的 DNS/IP。
MYSQL_DATABASE=y_link
MYSQL_USER=ylink
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 外发总时限覆盖 DNS/连接/响应/全部跳转；默认保留兼容跳转，strict 仅允许初始 Origin 或白名单且禁止 HTTPS 降级。
# 生产外发通知及验证码建议启用 strict 并为可信跳转配置完整 Origin，防止 HTTPS 降级及未授权跨源转发。
Y_LINK_OUTBOUND_REDIRECT_POLICY=compat
# 仅完整 HTTP/HTTPS Origin 的 JSON 数组；禁止 userinfo、通配符、路径、query/hash，仍执行每跳 SSRF/DNS 校验。
Y_LINK_OUTBOUND_REDIRECT_ALLOWED_ORIGINS=[]

# Onebox 可选后端降权（Nginx/supervisor 保持原身份）；只支持已准备卷，失败即停，不会 chown/chmod 或重建密钥。
Y_LINK_ONEBOX_NON_ROOT=false
