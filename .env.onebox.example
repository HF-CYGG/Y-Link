# Onebox 基础配置：复制为 .env 后再启动。
TZ=Asia/Shanghai
Y_LINK_PORT=8080
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_DISPLAY_NAME=系统管理员
INIT_ADMIN_PASSWORD=
PERMANENT_DELETE_PASSWORD=
INVITE_CODE_PEPPER=
# Onebox 具备退出码 75 重启恢复链路，默认允许自动迁移；不允许在线切库时可设为 false。
Y_LINK_AUTOMATIC_DB_MIGRATION_ENABLED=true

# SQLite Onebox 安全默认值通常无需修改。若 /health 显示写队列持续拥塞，应迁移 MySQL，
# 不要靠无限加大队列掩盖容量不足。
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_WRITE_QUEUE_MAX_PENDING=256
SQLITE_WRITE_QUEUE_TIMEOUT_MS=5000

# 迁移 MySQL 后由运行时覆盖使用；单个 Onebox 默认 20 条连接。
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=100
DB_MAX_QUERY_MS=200

# 正式加载 compose.onebox.mysql.yml 前再填写；叠加文件会对两个密码 fail-fast。
# 管理端自动迁移目标填写：host=mysql、port=3306、database=y_link、user=ylink。
# 若 MySQL 安装在 Linux 宿主机，可填写 host=host.docker.internal；远程数据库填写容器可达的 DNS/IP。
MYSQL_DATABASE=y_link
MYSQL_USER=ylink
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
